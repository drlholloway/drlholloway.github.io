{
  "name": "doks",
  "version": "0.0.0",
  "description": "Doks theme",
  "author": "Lane Holloway",
  "license": "MIT",
  "scripts": {
    "create": "hugo new",
    "dev": "hugo server --bind=0.0.0.0 --disableFastRender --baseURL=http://localhost --noHTTPCache",
    "dev:drafts": "hugo server --bind=0.0.0.0 --disableFastRender --baseURL=http://localhost --noHTTPCache --buildDrafts",
    "build": "hugo --minify --gc",
    "test": "echo \"Error: no test specified\"",
    "clean": "npm run clean:build && npm run clean:install",
    "clean:build": "node -e \"for (const p of ['public', 'resources', '.hugo_build.lock']) require('fs').rmSync(p, { recursive: true, force: true })\"",
    "clean:install": "node -e \"for (const p of ['node_modules', 'package-lock.json', 'yarn.lock', 'pnpm-lock.yaml']) require('fs').rmSync(p, { recursive: true, force: true })\"",
    "preinfo": "npm version",
    "info": "npm list",
    "postinfo": "hugo version"
  },
  "dependencies": {
    "@tabler/icons": "^3.49.0",
    "@thulite/doks-core": "^1.9.4",
    "@thulite/images": "^3.3.4",
    "@thulite/inline-svg": "^1.2.2",
    "@thulite/seo": "^2.4.4",
    "hugo-bin": "^0.166.0",
    "thulite": "^3.0.2"
  },
  "hugo-bin": {
    "buildTags": "extended"
  },
  "overrides": {
    "minimatch": "^10.2.2",
    "glob": "^13.0.6"
  },
  "engines": {
    "node": ">=22"
  }
}
